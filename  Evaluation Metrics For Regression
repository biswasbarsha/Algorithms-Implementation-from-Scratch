a":{"text/plain":"np.float64(0.5249246213812151)"},"metadata":{}}],"execution_count":17},{"cell_type":"markdown","source":"## Adjusted R²\n\n$$R^2_{adj} = 1 - \\frac{(1 - R^2)(n - 1)}{n - p - 1} = 1 - (1 - R^2) \\cdot \\frac{n - 1}{n - p - 1}$$\n\n* Adjusts R² for number of predictors, penalizing unnecessary complexity\n* Better for comparing models with different number of variables (will only improve with useful variables)\n* Use R² and Adj. R² in combination with other metrics\n* Also more suited for linear models (like R²)","metadata":{}},{"cell_type":"code","source":"X_test.shape","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-27T10:05:54.265272Z","iopub.execute_input":"2026-05-27T10:05:54.266144Z","iopub.status.idle":"2026-05-27T10:05:54.273568Z","shell.execute_reply.started":"2026-05-27T10:05:54.266096Z","shell.execute_reply":"2026-05-27T10:05:54.272539Z"}},"outputs":[{"execution_count":18,"output_type":"execute_result","data":{"text/plain":"(4128, 8)"},"metadata":{}}],"execution_count":18},{"cell_type":"code","source":"n = X_test.shape[0]\np = X_test.shape[1]","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-27T10:06:20.000535Z","iopub.execute_input":"2026-05-27T10:06:20.001057Z","iopub.status.idle":"2026-05-27T10:06:20.005986Z","shell.execute_reply.started":"2026-05-27T10:06:20.001022Z","shell.execute_reply":"2026-05-27T10:06:20.004998Z"}},"outputs":[],"execution_count":19},{"cell_type":"code","source":"R2_adj_reg = 1-((1-R2_reg)*(n-1))/(n-p-1)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-27T10:07:08.335935Z","iopub.execute_input":"2026-05-27T10:07:08.337036Z","iopub.status.idle":"2026-05-27T10:07:08.341684Z","shell.execute_reply.started":"2026-05-27T10:07:08.336998Z","shell.execute_reply":"2026-05-27T10:07:08.340617Z"}},"outputs":[],"execution_count":20},{"cell_type":"code","source":"R2_adj_reg","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-27T10:07:09.549975Z","iopub